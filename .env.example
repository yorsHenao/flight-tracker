# =====================================================================
# CONFIGURACION DE VARIABLES DE ENTORNO - MIS VUELOS
# =====================================================================
# La app NO arranca si las tres primeras faltan o tienen estos valores de ejemplo.
# Genera la clave con:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
VUELOS_SECRET_KEY=genera_una_clave_larga_y_aleatoria
VUELOS_INVITE_CODE=pon_aqui_tu_codigo
VUELOS_INVITE_MAX_USES=5

# Administrador (la clave solo se usa al crear el admin por primera vez; minimo 10 caracteres)
VUELOS_ADMIN_USER=admin
VUELOS_ADMIN_EMAIL=tu_correo@gmail.com
VUELOS_ADMIN_PASS=pon_aqui_tu_clave

# Correo Gmail (SMTP). Contrasena de aplicacion de Google de 16 letras.
VUELOS_SMTP_ENABLED=true
VUELOS_SMTP_HOST=smtp.gmail.com
VUELOS_SMTP_PORT=587
VUELOS_SMTP_USE_TLS=true
VUELOS_SMTP_USER=tu_correo@gmail.com
VUELOS_SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx
VUELOS_SMTP_FROM_NAME=Vuelos Economicos

# URL publica y chequeos
VUELOS_BASE_URL=https://TU_USUARIO.pythonanywhere.com
VUELOS_CHECK_INTERVAL=1800
VUELOS_BG_THREAD=true

# Limites y alertas
VUELOS_MAX_ACTIVE_ROUTES=10
VUELOS_ALERT_MIN_DROP_PCT=2

# HTTPS (cookie Secure + HSTS). Vacio = automatico (activo en PythonAnywhere). false solo en local por http.
VUELOS_HTTPS=

# Modo demo con precios simulados. NUNCA true en produccion.
VUELOS_DEMO_MODE=false

# Revision de precios desde cron-job.org (PythonAnywhere gratis no tiene Tasks).
# Ruta: /tareas/revisar con la cabecera X-Cron-Token. Vacio = ruta desactivada.
# Genera el token con:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
VUELOS_CRON_TOKEN=genera_un_token_largo_y_aleatorio
